# What scripts/build.sh builds. A change here, pushed to main, builds and publishes a new image
# (.github/workflows/build.yml).

# The Jetson Linux (L4T) BSP: public, no login. The daily release check (scripts/check-release.py)
# rewrites these three lines and commits them when NVIDIA publishes a newer release with the same
# major version. NVIDIA publishes no checksum, so the first download is the pin; by hand, compute
# it once (curl -fL <url> | sha256sum) and put it here with the URL and the version.
L4T_VERSION=39.2.1
BSP_URL=https://developer.download.nvidia.com/embedded/L4T/r39_Release_v2.1/release/Jetson_Linux_R39.2.1_aarch64.tbz2
BSP_SHA256=2e5619088ba88e85dab25247f033d70659b6f676ff835176a07766dcb0fdbe6b

# The Orin Nano Developer Kit's module (P3767-0005, 8 GB), the only Orin Nano/NX module with a
# microSD slot, at the higher "super" power budget. NVIDIA's on-device tooling picks the -super
# firmware for this SKU. The module's QSPI must be flashed with the same config and L4T release.
BOARD_CONFIG=jetson-orin-nano-devkit-super

# NVIDIA's nv_build_samplefs.sh: minimal is headless (no GNOME, no oem-config), on Ubuntu 24.04.
ROOTFS_FLAVOR=minimal
UBUNTU_CODENAME=noble
